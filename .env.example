# ============================================================================
# Northstar Alpha Engine — configuration
# Copy to .env and fill in. NEVER commit .env. Every setting has a safe default.
# All variables use the NORTHSTAR_ prefix.
# ============================================================================

# ---------------------------------------------------------------- Discord (required to post)
NORTHSTAR_DISCORD_TOKEN=
NORTHSTAR_DISCORD_CHANNEL_ID=
# Optional: send warnings to a different channel (defaults to the main channel)
NORTHSTAR_DISCORD_WARNING_CHANNEL_ID=
# true = never post; alerts are written to data/dry_run_alerts.jsonl. Start with true.
NORTHSTAR_DRY_RUN=true

# ---------------------------------------------------------------- Optional API keys
# Helius free tier: a much more reliable RPC than the public endpoint (recommended)
NORTHSTAR_HELIUS_API_KEY=
# Used only when no Helius key is set
NORTHSTAR_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Not required for the free launch/migration streams.
NORTHSTAR_PUMPPORTAL_API_KEY=
# OPTIONAL / METERED: trade events cost 0.01 SOL per 10,000 messages (PumpPortal terms).
# Requires a PumpPortal API key and linked wallet; keep false unless you accept those costs.
NORTHSTAR_ENABLE_PUMPPORTAL_TRADES=false
NORTHSTAR_MAX_PUMPPORTAL_TRADE_SUBSCRIPTIONS=100
NORTHSTAR_PUMPPORTAL_TRADE_SUBSCRIPTION_TTL_SECONDS=300

# ---------------------------------------------------------------- Providers on/off
NORTHSTAR_ENABLE_DEXSCREENER=true
NORTHSTAR_ENABLE_RUGCHECK=true
NORTHSTAR_ENABLE_RPC=true
NORTHSTAR_ENABLE_PUMPPORTAL=true

# ---------------------------------------------------------------- Rate limits (requests/minute) and daily budgets
NORTHSTAR_DEXSCREENER_SLOW_RPM=50
NORTHSTAR_DEXSCREENER_FAST_RPM=200
NORTHSTAR_RUGCHECK_RPM=30
# Public RPC is strict; with Helius free tier you can raise this
NORTHSTAR_RPC_RPM=240
NORTHSTAR_DEXSCREENER_DAILY_BUDGET=150000
NORTHSTAR_RUGCHECK_DAILY_BUDGET=10000
NORTHSTAR_RPC_DAILY_BUDGET=200000

# ---------------------------------------------------------------- Scheduling
NORTHSTAR_DISCOVERY_INTERVAL_SECONDS=60
NORTHSTAR_RESEARCH_CONCURRENCY=4
NORTHSTAR_MONITOR_INTERVAL_SECONDS=120
NORTHSTAR_WATCHLIST_RECHECK_SECONDS=600
NORTHSTAR_NEW_TOKEN_INITIAL_DELAY_SECONDS=20
NORTHSTAR_MIN_CURVE_TRADE_EVENTS=15
NORTHSTAR_MIN_CURVE_UNIQUE_BUYERS=8
NORTHSTAR_MIN_CURVE_BUY_SELL_RATIO=1.35
NORTHSTAR_MIN_CURVE_BUY_SOL_5M=2.0
NORTHSTAR_MIN_CURVE_EARLY_SCORE=75
# Early watches are skipped once the curve is up more than this % since launch
NORTHSTAR_MAX_CURVE_CHASE_PCT=400
# How often open early-watch posts are re-read from the bonding curve and edited
NORTHSTAR_EARLY_WATCH_REFRESH_SECONDS=120
# Verified PumpSwap swaps needed before post-migration demand counts as VERIFIED
NORTHSTAR_MIN_VERIFIED_SWAPS=15

# ---------------------------------------------------------------- Filters and gates
NORTHSTAR_MAX_TOKEN_AGE_HOURS=72
NORTHSTAR_PREFILTER_MIN_LIQUIDITY_USD=5000
NORTHSTAR_MIN_LIQUIDITY_USD=25000
NORTHSTAR_MIN_LIQUIDITY_TO_MCAP=0.12
NORTHSTAR_MAX_PRICE_AGE_SECONDS=300
NORTHSTAR_ALLOW_ACTIVE_MINT_AUTHORITY=false
NORTHSTAR_ALLOW_ACTIVE_FREEZE_AUTHORITY=false
NORTHSTAR_MAX_TRANSFER_FEE_BPS=100
NORTHSTAR_MAX_TOP10_ADJUSTED_PCT=25
NORTHSTAR_MAX_SINGLE_HOLDER_ADJUSTED_PCT=8
NORTHSTAR_MAX_CREATOR_HOLDING_PCT=5
NORTHSTAR_MAX_CLUSTER_SUPPLY_PCT=10
NORTHSTAR_MAX_CREATOR_SELL_PCT_OF_SUPPLY=2
NORTHSTAR_LIQUIDITY_DROP_REJECT_PCT=35
NORTHSTAR_MAX_PRICE_EXTENSION_H6_PCT=200
NORTHSTAR_REQUIRE_LP_LOCK_VERIFIED=true
NORTHSTAR_REJECT_ON_RUGCHECK_DANGER=true

# ---------------------------------------------------------------- Publication policy
NORTHSTAR_MIN_OPPORTUNITY_SCORE=88
NORTHSTAR_WATCHLIST_MIN_SCORE=75
# 0-25 scale (NOT 0-100). Values above 25 make AUTO_POST impossible.
NORTHSTAR_MIN_NARRATIVE_SCORE=18
NORTHSTAR_MIN_NARRATIVE_EVIDENCE_ITEMS=3
NORTHSTAR_MAX_ALLOWED_RISK=LOW_DETECTED
NORTHSTAR_MIN_CONFIDENCE=HIGH
NORTHSTAR_ALERT_COOLDOWN_HOURS=36
NORTHSTAR_MAX_DAILY_ALERTS=2

# ---------------------------------------------------------------- Score weights (should sum to 100)
NORTHSTAR_W_NARRATIVE=25
NORTHSTAR_W_DEMAND=20
NORTHSTAR_W_LIQUIDITY=20
NORTHSTAR_W_HOLDERS=15
NORTHSTAR_W_MOMENTUM=10
NORTHSTAR_W_WALLET_QUALITY=5
NORTHSTAR_W_EVIDENCE=5

# ---------------------------------------------------------------- Monitoring
NORTHSTAR_MILESTONES=1.5,2,3,5,10
NORTHSTAR_LIQUIDITY_COLLAPSE_PCT=50
NORTHSTAR_SEVERE_DRAWDOWN_PCT=50
NORTHSTAR_MAX_TRACKING_HOURS=72
NORTHSTAR_EMBED_EDIT_MIN_SECONDS=300

# ---------------------------------------------------------------- Entry / exit plan (posted with every call)
# Runner plan: bank a third at 2x, a third at 4x, let the last third ride (learning retunes these)
NORTHSTAR_TRADE_PLAN_ENABLED=true
NORTHSTAR_PLAN_MAX_ENTRY_PCT=25
NORTHSTAR_PLAN_TP1=2.0
NORTHSTAR_PLAN_TP1_SELL_PCT=33
NORTHSTAR_PLAN_TP2=4.0
NORTHSTAR_PLAN_TP2_SELL_PCT=33
NORTHSTAR_PLAN_STOP=0.65
NORTHSTAR_PLAN_TRAIL_PCT=40
NORTHSTAR_PLAN_TIME_STOP_MINUTES=45
NORTHSTAR_PLAN_TIME_STOP_MULTIPLE=1.2

# ---------------------------------------------------------------- Self-learning
# Every researched coin is scored against its real price path; settings are retuned only when a
# change holds up on recent coins it was not fitted on. Rug/safety checks are never tuned.
NORTHSTAR_LEARNING_ENABLED=true
NORTHSTAR_LEARNING_INTERVAL_HOURS=6
NORTHSTAR_LEARNING_MIN_SAMPLES=20
# Learning brain: learns what makes a RUNNER (2x before -40%). It only gets a say in calls once it
# beats a coin flip on coins it has not seen.
NORTHSTAR_BRAIN_ENABLED=true
NORTHSTAR_BRAIN_WIN_X=2.0
NORTHSTAR_BRAIN_LOSS_X=0.6
NORTHSTAR_BRAIN_MIN_SAMPLES=150
NORTHSTAR_BRAIN_MIN_AUC=0.58
NORTHSTAR_RADAR_LEARNING=true

# ---------------------------------------------------------------- Storage / logging
NORTHSTAR_DATA_DIR=data
# Database retention (0 = keep forever; discovery events grow ~70 MB/day)
NORTHSTAR_DISCOVERY_RETENTION_DAYS=4
NORTHSTAR_SNAPSHOT_RETENTION_DAYS=7
NORTHSTAR_LOG_LEVEL=INFO
NORTHSTAR_LOG_JSON=true

# Monetization routing: existing DISCORD_CHANNEL_ID is the VIP/immediate channel.
# Free channel gets a delayed copy and selected milestones.
NORTHSTAR_DISCORD_FREE_CHANNEL_ID=
NORTHSTAR_FREE_CALLOUT_DELAY_MINUTES=15
NORTHSTAR_FREE_MILESTONES=2,3,5,10

# Web control panel (starts with the bot). LOCKED until a password is set.
NORTHSTAR_DASHBOARD_ENABLED=true
NORTHSTAR_DASHBOARD_PASSWORD=
# Wispbyte's SERVER_PORT (or PORT) is used automatically; otherwise this
NORTHSTAR_DASHBOARD_PORT=8080
NORTHSTAR_DASHBOARD_HOST=0.0.0.0

# ---------------------------------------------------------------- Rug check / bubblemap
# 2 = also trace who funded the funders (dev -> middle wallet -> holder)
NORTHSTAR_FUNDING_TRACE_HOPS=2
NORTHSTAR_FUNDING_TRACE_FUNDERS=10

# ---------------------------------------------------------------- Early narrative calls (30-50k)
# Bonding-curve coins that ride a LIVE narrative, judged by Claude against pump.fun launch waves,
# news, trending searches and Wikipedia. Posted to VIP; a copy goes to the free channel at 1.5x.
NORTHSTAR_EARLY_CALL_ENABLED=true
NORTHSTAR_EARLY_CALL_MIN_MC=30000
NORTHSTAR_EARLY_CALL_MAX_MC=50000
NORTHSTAR_EARLY_CALL_MIN_AI_SCORE=70
NORTHSTAR_EARLY_CALL_MIN_TRADES=10
NORTHSTAR_EARLY_CALL_MIN_BUYERS=8
NORTHSTAR_EARLY_CALL_MIN_BUY_SELL_RATIO=1.2
NORTHSTAR_EARLY_CALL_MIN_BUY_SOL_5M=1.0
# 0 = no limit (post every coin that qualifies)
NORTHSTAR_EARLY_CALL_MAX_PER_HOUR=0
NORTHSTAR_EARLY_CALL_FREE_AT=1.5
NORTHSTAR_EARLY_CALL_TRACK_HOURS=24
# Early plan (tighter than the VIP runner plan)
NORTHSTAR_EARLY_MAX_ENTRY_PCT=20
NORTHSTAR_EARLY_TP1=2.0
NORTHSTAR_EARLY_TP1_SELL_PCT=40
NORTHSTAR_EARLY_TP2=4.0
NORTHSTAR_EARLY_TP2_SELL_PCT=30
NORTHSTAR_EARLY_STOP=0.6
NORTHSTAR_EARLY_TRAIL_PCT=40
NORTHSTAR_EARLY_TIME_STOP_MINUTES=30
NORTHSTAR_EARLY_TIME_STOP_MULTIPLE=1.15
# Curve radar: finds bonding-curve coins entering the band
NORTHSTAR_CURVE_RADAR_ENABLED=true
NORTHSTAR_CURVE_RADAR_SECONDS=120
NORTHSTAR_CURVE_RADAR_MIN_BUYS_M5=12


# ---------------------------------------------------------------- AI narrative judge (FREE options)
# Pick a provider and paste its key. The free ones need no credit card:
#   groq       console.groq.com            fast, generous free tier   (default)
#   gemini     aistudio.google.com         free tier, Flash models
#   openrouter openrouter.ai               free ":free" models
#   cerebras   cloud.cerebras.ai           free tier
#   mistral    console.mistral.ai          free tier
#   github     github.com/marketplace/models  free with a GitHub account
#   local      a model on your own PC (no key, bot must reach it)
#   anthropic  console.anthropic.com       paid
NORTHSTAR_AI_PROVIDER=groq
NORTHSTAR_AI_KEY=
# Optional overrides (leave blank to use the provider's default)
NORTHSTAR_AI_MODEL=
NORTHSTAR_AI_BASE_URL=
NORTHSTAR_AI_ENABLED=true
NORTHSTAR_AI_MAX_CALLS_PER_HOUR=120
NORTHSTAR_AI_DAILY_BUDGET_USD=1.0
NORTHSTAR_AI_RECHECK_MINUTES=30
# Free tiers cost nothing, so these stay 0 unless you use a paid provider
NORTHSTAR_AI_PRICE_INPUT_PER_MTOK=0
NORTHSTAR_AI_PRICE_OUTPUT_PER_MTOK=0
# CoinGecko narratives (trending coins + hot sectors) use your existing CoinGecko key
NORTHSTAR_EVENTS_COINGECKO=true

# ---------------------------------------------------------------- Unified decision engine
# One score, one risk class, one decision (docs/DECISION_ENGINE.md). false = v2.3.0 behaviour.
# Pump.fun emits hundreds of launches an hour; almost all die with no pool and no trades.
# false = a launch is researched only once the curve radar sees real buying in the early band.
# true = the old behaviour, researching every launch on a timer (burns the RPC budget).
NORTHSTAR_RESEARCH_NEW_LAUNCHES_ON_TIMER=false

NORTHSTAR_UNIFIED_ENABLED=true
# Category weights, must sum to 100. Starting assumptions, not fitted coefficients.
NORTHSTAR_U_W_SAFETY=18
NORTHSTAR_U_W_LIQUIDITY=20
NORTHSTAR_U_W_HOLDERS=16
NORTHSTAR_U_W_DEV=10
NORTHSTAR_U_W_STRUCTURE=20
NORTHSTAR_U_W_NARRATIVE=16
NORTHSTAR_U_STRONG_MIN=68
NORTHSTAR_U_WATCH_MIN=48
NORTHSTAR_U_MIN_COMPLETENESS=0.55
NORTHSTAR_U_MODEL_TILT=12
# At most this many of the points a STRONG call needs may come from narrative (v2.4 shipped 20,
# which could never bind because narrative is worth at most 16 of 82 scored points).
NORTHSTAR_U_NARRATIVE_CAP=10
# v2.5: the score is the OPPORTUNITY score; safety is decided by the veto layer alone.
# true = v2.4 formula where clean safety checks also added score points.
NORTHSTAR_U_SCORE_INCLUDES_SAFETY=false
# true = v2.4 behaviour: fewer narrative evidence items than NORTHSTAR_MIN_NARRATIVE_EVIDENCE_ITEMS
# REJECTS the coin. false = it caps the decision at WATCH and lowers confidence instead.
NORTHSTAR_U_NARRATIVE_BLOCKS=false
# Rug scalps (momentum rugs posted as labelled scalp calls). Off since v2.5.2: on the live history
# they lost money on their real price paths. true = post them again.
NORTHSTAR_SCALP_ENABLED=false
# Exit cost at the largest tested sell size that filled: warn (caps at WATCH) / block (no call).
NORTHSTAR_U_EXIT_IMPACT_WARN_PCT=5
NORTHSTAR_U_EXIT_IMPACT_BLOCK_PCT=15
# A price drop of this much in the 1h / 6h / 24h window marks a collapse (dump in progress).
NORTHSTAR_COLLAPSE_H1_DROP_PCT=50
NORTHSTAR_COLLAPSE_H6_DROP_PCT=60
NORTHSTAR_COLLAPSE_H24_DROP_PCT=75

# ------------------------------------------------- Exit check / sellability (Jupiter, free, no key)
# Asks Jupiter what you would actually receive for selling these dollar sizes back to SOL.
# A coin you cannot sell is flagged, however good it looks.
NORTHSTAR_ENABLE_JUPITER=true
NORTHSTAR_JUPITER_SELL_SIZES_USD=100,500,1000
NORTHSTAR_JUPITER_RPM=20

# ---------------------------------------------------------------- Live event feeds (free, no keys)
NORTHSTAR_EVENTS_NEWS=true
NORTHSTAR_EVENTS_TRENDS=true
NORTHSTAR_EVENTS_WIKIPEDIA=true
NORTHSTAR_EVENTS_NEWS_SECONDS=600
